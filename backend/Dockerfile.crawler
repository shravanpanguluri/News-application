FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libffi-dev libxml2-dev libxslt1-dev \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /tmp/requirements.txt
COPY backend/requirements-crawler.txt /tmp/requirements-crawler.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt -r /tmp/requirements-crawler.txt \
    && crawl4ai-setup

COPY backend/ /app/

CMD ["python", "crawl4ai_worker.py", "--once"]
