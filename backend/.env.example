# Predovex Backend Environment Variables
# Copy this file to .env and fill in your actual keys

# ========================================
# Existing Variables
# ========================================

# NewsAPI Key (already have this)
REACT_APP_NEWS_API_KEY=your_news_api_key_here

# Database
# Local default. Render will inject a PostgreSQL connection string.
DATABASE_URL=sqlite:///./government_intelligence.db

# JWT Secret
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ========================================
# NEW: Reddit API Keys (Required for Reddit Sentiment)
# Get at: https://www.reddit.com/prefs/apps
# Takes 2 minutes to create an app
# ========================================

REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=Predovex/1.0 (by /u/yourusername)

# ========================================
# NEW: FRED API Key (Required for Economic Data)
# Get at: https://fred.stlouisfed.org/docs/api/api_key.html
# Instant approval, completely FREE
# ========================================

FRED_API_KEY=your_fred_api_key_here

# ========================================
# Optional: Additional API Keys
# ========================================

# Alpha Vantage (Stock data alternative)
ALPHA_VANTAGE_API_KEY=

# Finnhub (Stock data)
FINNHUB_API_KEY=

# Twitter/X API (for social sentiment)
TWITTER_BEARER_TOKEN=
